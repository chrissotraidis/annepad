+static const char* controller_reconcile_reason_name(ControllerReconcileReason reason) {
+    switch (reason) {
+        case ControllerReconcileReason::Startup: return "startup";
+        case ControllerReconcileReason::Added: return "device-added";
+        case ControllerReconcileReason::Removed: return "device-removed";
+        case ControllerReconcileReason::Remapped: return "device-remapped";
+        case ControllerReconcileReason::Foreground: return "foreground";
+        case ControllerReconcileReason::Periodic: return "active-check";
+        case ControllerReconcileReason::LauncherConfig: return "launcher-config";
+        default: return "unspecified";
+    }
+}
+
+static bool controller_handle_valid(std::size_t slot) {
+    SDL_GameController* pad = g_controller_pads[slot];
+    if (pad == nullptr || !SDL_GameControllerGetAttached(pad)) return false;
+    SDL_Joystick* joystick = SDL_GameControllerGetJoystick(pad);
+    return joystick != nullptr &&
+        static_cast<int>(SDL_JoystickInstanceID(joystick)) == g_controller_instances[slot];
+}
+
+static void close_controller_slot(std::size_t slot, const char* reason) {
+    SDL_GameController* pad = g_controller_pads[slot];
+    if (pad != nullptr) {
+        std::fprintf(stderr,
+            "[controller] released/closed reason=%s instance=%d player=%zu name='%s'\n",
+            reason, g_controller_instances[slot], slot + 1,
+            g_controller_names[slot].empty() ? "(unknown)" : g_controller_names[slot].c_str());
+        SDL_GameControllerClose(pad);
+    }
+    g_controller_pads[slot] = nullptr;
+    g_controller_instances[slot] = pkmnstadium::controller::kNoController;
+    g_controller_names[slot].clear();
+}
+
+static std::vector<EnumeratedController> enumerate_controllers() {
+    std::vector<EnumeratedController> current;
+    const int joystick_count = SDL_NumJoysticks();
+    for (int device_index = 0; device_index < joystick_count; ++device_index) {
+        if (!SDL_IsGameController(device_index)) continue;
+        EnumeratedController device;
+        device.device_index = device_index;
+        device.instance = static_cast<int>(SDL_JoystickGetDeviceInstanceID(device_index));
+        const char* name = SDL_GameControllerNameForIndex(device_index);
+        device.name = name != nullptr ? name : "(unknown)";
+        if (device.instance >= 0) current.push_back(std::move(device));
+    }
+    return current;
+}
+
+static void reconcile_controllers(ControllerReconcileReason reason) {
+#ifndef __APPLE__
+    SDL_PumpEvents();
+    SDL_GameControllerUpdate();
+#endif
+    const char* reason_name = controller_reconcile_reason_name(reason);
+    const auto current = enumerate_controllers();
+    std::vector<int> current_instances;
+    current_instances.reserve(current.size());
+    for (const auto& device : current) current_instances.push_back(device.instance);
+    if (reason != ControllerReconcileReason::Periodic) {
+        std::fprintf(stderr, "[controller] reconcile reason=%s devices=%zu\n",
+                     reason_name, current.size());
+    }
+
+    pkmnstadium::controller::Eligibility eligible{};
+    for (std::size_t slot = 0; slot < eligible.size(); ++slot) {
+        eligible[slot] = !g_launcher_input_active.load() ||
+            g_port_kind[slot] == pkmnstadium::recompui::DeviceKind::Gamepad;
+        if (g_controller_pads[slot] != nullptr && !controller_handle_valid(slot)) {
+            close_controller_slot(slot, reason_name);
+        }
+    }
+
+    const auto plan = pkmnstadium::controller::reconcile_slots(
+        g_controller_instances, eligible, current_instances.data(), current_instances.size());
+    for (std::size_t slot = 0; slot < plan.instances.size(); ++slot) {
+        if (g_controller_instances[slot] != plan.instances[slot]) {
+            if (g_controller_pads[slot] != nullptr) close_controller_slot(slot, reason_name);
+            g_controller_instances[slot] = plan.instances[slot];
+        }
+        if (g_controller_instances[slot] < 0 || g_controller_pads[slot] != nullptr) continue;
+
+        const auto found = std::find_if(current.begin(), current.end(), [&](const auto& device) {
+            return device.instance == g_controller_instances[slot];
+        });
+        if (found == current.end()) {
+            g_controller_instances[slot] = pkmnstadium::controller::kNoController;
+            continue;
+        }
+        SDL_GameController* pad = SDL_GameControllerOpen(found->device_index);
+        if (pad == nullptr) {
+            std::fprintf(stderr,
+                "[controller] open-failed reason=%s instance=%d player=%zu device-index=%d name='%s' error='%s'\n",
+                reason_name, found->instance, slot + 1, found->device_index,
+                found->name.c_str(), SDL_GetError());
+            g_controller_instances[slot] = pkmnstadium::controller::kNoController;
+            continue;
+        }
+        g_controller_pads[slot] = pad;
+        g_controller_names[slot] = found->name;
+        std::fprintf(stderr,
+            "[controller] assigned reason=%s instance=%d player=%zu device-index=%d name='%s'\n",
+            reason_name, found->instance, slot + 1, found->device_index,
+            found->name.c_str());
+    }
+    std::fflush(stderr);
+    g_controller_reconciled = true;
+    g_next_controller_check = std::chrono::steady_clock::now() + std::chrono::seconds(1);
+}
 
