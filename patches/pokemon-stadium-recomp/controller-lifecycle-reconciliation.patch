@@ -0,0 +1,70 @@
+#pragma once
+
+#include <array>
+#include <cstddef>
+
+namespace pkmnstadium::controller {
+
+constexpr std::size_t kPlayerCount = 4;
+constexpr int kNoController = -1;
+
+using Instances = std::array<int, kPlayerCount>;
+using Eligibility = std::array<bool, kPlayerCount>;
+
+struct ReconcilePlan {
+    Instances instances{};
+    std::array<bool, kPlayerCount> released{};
+    std::array<bool, kPlayerCount> assigned{};
+};
+
+inline bool contains_instance(const int* current, std::size_t count, int instance) {
+    if (instance < 0) return false;
+    for (std::size_t i = 0; i < count; ++i) {
+        if (current[i] == instance) return true;
+    }
+    return false;
+}
+
+inline ReconcilePlan reconcile_slots(const Instances& previous,
+                                     const Eligibility& eligible,
+                                     const int* current,
+                                     std::size_t current_count) {
+    ReconcilePlan plan;
+    plan.instances.fill(kNoController);
+
+    // Retain valid ownership in place. Duplicate or vanished identities are
+    // released so they cannot occupy a player slot indefinitely.
+    for (std::size_t slot = 0; slot < kPlayerCount; ++slot) {
+        const int instance = previous[slot];
+        bool already_retained = false;
+        for (std::size_t prior = 0; prior < slot; ++prior) {
+            already_retained |= plan.instances[prior] == instance;
+        }
+        if (eligible[slot] && contains_instance(current, current_count, instance) &&
+            !already_retained) {
+            plan.instances[slot] = instance;
+        } else if (instance >= 0) {
+            plan.released[slot] = true;
+        }
+    }
+
+    // Assign genuinely unowned controllers in enumeration order to the first
+    // eligible free slot. Existing players never move.
+    for (std::size_t device = 0; device < current_count; ++device) {
+        const int instance = current[device];
+        if (contains_instance(plan.instances.data(), plan.instances.size(), instance)) {
+            continue;
+        }
+        for (std::size_t slot = 0; slot < kPlayerCount; ++slot) {
+            if (eligible[slot] && plan.instances[slot] < 0) {
+                plan.instances[slot] = instance;
+                plan.assigned[slot] = true;
+                break;
+            }
+        }
+    }
+
+    return plan;
+}
+
+} // namespace pkmnstadium::controller
