+/* Validate Stadium's null-terminated active audio-voice list before its
+ * expiration walker runs. A duplicated enqueue can leave stale prev/tail
+ * metadata or a cycle; func_8003C408 then repeatedly frees the same voices.
+ * Rebuild only the reachable, unique prefix and reject an incoming node that
+ * is already active. The game configures at most 64 voices. */
+int pkmnstadium_audio_active_list_prepare(uint8_t* rdram, uint32_t incoming_v) {
+    enum { MAX_AUDIO_VOICES = 64 };
+    static const uint32_t head_p = 0x000FC808u;
+    static const uint32_t tail_p = 0x000FC80Cu;
+    static const uint32_t count_p = 0x000FC81Cu;
+    uint32_t nodes[MAX_AUDIO_VOICES];
+    uint32_t node_v = MEM_LOAD_BE32(rdram, head_p);
+    uint32_t count = 0;
+    int repair = 0;
+
+    while (node_v != 0 && count < MAX_AUDIO_VOICES) {
+        uint32_t i;
+        if (node_v < 0x80000000u || node_v >= 0x80800000u) {
+            repair = 1;
+            break;
+        }
+        for (i = 0; i < count; i++) {
+            if (nodes[i] == node_v) {
+                repair = 1;
+                break;
+            }
+        }
+        if (i != count) break;
+        nodes[count++] = node_v;
+        node_v = MEM_LOAD_BE32(rdram, (node_v & 0x1FFFFFFFu));
+    }
+    if (node_v != 0) repair = 1;
+
+    for (uint32_t i = 0; i < count; i++) {
+        uint32_t node_p = nodes[i] & 0x1FFFFFFFu;
+        uint32_t expected_prev = (i == 0) ? 0 : nodes[i - 1];
+        if (MEM_LOAD_BE32(rdram, node_p + 4) != expected_prev) repair = 1;
+    }
+
+    {
+        uint32_t expected_tail = (count == 0) ? 0 : nodes[count - 1];
+        if (MEM_LOAD_BE32(rdram, tail_p) != expected_tail ||
+            MEM_LOAD_BE32(rdram, count_p) != count) {
+            repair = 1;
+        }
+    }
+
+    if (repair) {
+        for (uint32_t i = 0; i < count; i++) {
+            uint32_t node_p = nodes[i] & 0x1FFFFFFFu;
+            uint32_t next = (i + 1 < count) ? nodes[i + 1] : 0;
+            uint32_t prev = (i == 0) ? 0 : nodes[i - 1];
+            mem_store_be32(rdram, node_p, next);
+            mem_store_be32(rdram, node_p + 4, prev);
+        }
+        mem_store_be32(rdram, head_p, (count == 0) ? 0 : nodes[0]);
+        mem_store_be32(rdram, tail_p, (count == 0) ? 0 : nodes[count - 1]);
+        mem_store_be32(rdram, count_p, count);
+    }
+
+    for (uint32_t i = 0; i < count; i++) {
+        if (nodes[i] == incoming_v) return 0;
+    }
+    return 1;
+}
