+// Explicit game.toml diagnosis hooks are useful in validation builds but can
+// be numerous and hot. Remove both their calls and argument evaluation from
+// the shipping AOT core while leaving separately classified correctness hooks
+// in place.
+#if defined(ANNEPAD_RELEASE_BUILD)
+#define ANNEPAD_DIAGNOSTIC_HOOK(...)
+#else
+#define ANNEPAD_DIAGNOSTIC_HOOK(...) __VA_ARGS__
+#endif
+
 #if PKMNSTADIUM_TRACE_HOOKS
 #define TRACE_ENTRY()  pkmnstadium_trace_entry_ctx(__func__, ctx);
 #define TRACE_RETURN() pkmnstadium_trace_return_ctx(__func__, ctx);
