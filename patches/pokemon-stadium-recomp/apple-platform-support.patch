+static void handle_mobile_lifecycle_event(uint32_t event_type) {
+    if (event_type == SDL_APP_WILLENTERBACKGROUND ||
+        event_type == SDL_APP_TERMINATING) {
+        if (audio_device != 0) {
+            SDL_PauseAudioDevice(audio_device, 1);
+        }
+        const bool saved = ultramodern::flush_save_file();
+        std::fprintf(stderr, "[AnnePad] lifecycle: %s; save %s\n",
+                     event_type == SDL_APP_TERMINATING ? "terminating" : "backgrounding",
+                     saved ? "flushed" : "flush failed");
+        std::fflush(stderr);
+    }
+    else if (event_type == SDL_APP_DIDENTERFOREGROUND) {
+        if (audio_device != 0) {
+            SDL_PauseAudioDevice(audio_device, 0);
+        }
+        std::fprintf(stderr, "[AnnePad] lifecycle: foreground active\n");
+        std::fflush(stderr);
+    }
+    else if (event_type == SDL_APP_LOWMEMORY) {
+        // The renderer owns no rebuildable application cache here; acknowledge
+        // the warning without discarding live emulation state.
+        std::fprintf(stderr, "[AnnePad] lifecycle: memory pressure received\n");
+        std::fflush(stderr);
+    }
+}
