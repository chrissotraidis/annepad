+        static std::atomic<uint32_t> voice_repair_count{0};
+        const uint32_t n =
+            voice_repair_count.fetch_add(1, std::memory_order_relaxed);
+        if (n < 8u) {
+            std::fprintf(stderr,
+                "[audio-uaf] rejected stale secondary handler=0x%08X; "
+                "caller will silence voice\n",
+                (uint32_t)g_self_heal_addr);
+            std::fflush(stderr);
+        }
+        ctx->r2 = 0;
+        return;
+    }
+
