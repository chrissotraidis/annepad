+        static std::atomic<uint32_t> repair_count{0};
+        const uint32_t n = repair_count.fetch_add(1, std::memory_order_relaxed);
+        if (n < 8u) {
+            std::fprintf(stderr,
+                "[audio-uaf] repaired stale dc_dma=0x%08X state=0x%08X "
+                "rom=0x%08X len=0x%X\n",
+                (uint32_t)g_self_heal_addr, (uint32_t)ctx->r6,
+                (uint32_t)ctx->r4, (uint32_t)ctx->r5);
+            std::fflush(stderr);
+        }
+        ctx->r6 = (gpr)(int32_t)0x800FCAB8u; // Stadium dmaState
+        recomp_func_t* dma = get_function((int32_t)0x8003C8DCu); // __amDMA
+        dma(rdram, ctx);
+        return;
