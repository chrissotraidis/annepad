+static std::atomic<bool> g_synchronous_audio_tasks{false};
 
 extern "C" uint64_t ultramodern_submit_gfx_count(void) { return g_submit_gfx.load(); }
 extern "C" uint64_t ultramodern_submit_audio_count(void) { return g_submit_audio.load(); }
@@ -1370,6 +1371,10 @@ extern "C" uint64_t ultramodern_submit_other_count(void) { return g_submit_other
 extern "C" uint64_t ultramodern_sp_complete_count(void);
 extern "C" uint64_t ultramodern_dp_complete_count(void);
 
+void ultramodern::set_synchronous_audio_tasks(bool enabled) {
+    g_synchronous_audio_tasks.store(enabled, std::memory_order_release);
+}
+
 void ultramodern::submit_rsp_task(RDRAM_ARG PTR(OSTask) task_) {
     OSTask* task = TO_PTR(OSTask, task_);
 
@@ -1395,7 +1400,17 @@ void ultramodern::submit_rsp_task(RDRAM_ARG PTR(OSTask) task_) {
         (void)run_rsp_task_or_warn(PASS_RDRAM task);
         cosim_schedule_rcp_event(CosimRcpEventKind::SpComplete, task->t.type, cosim_rsp_sp_delay());
 #else
-        events_context.sp_task_queue.enqueue(task);
+        if (task->t.type == M_AUDTASK &&
+            g_synchronous_audio_tasks.load(std::memory_order_acquire)) {
+            // Stadium builds its announcer/crowd stream from shallow CPU-fed
+            // rings that it starts rewriting for the next frame immediately
+            // after submitting this task. Consume those inputs before returning
+            // so the host SP thread cannot observe a later frame's samples.
+            (void)run_rsp_task_or_warn(PASS_RDRAM task);
+            sp_complete(task->t.type);
+        } else {
+            events_context.sp_task_queue.enqueue(task);
+        }
 #endif
     }
