 const char* GetHomeDirectory() {
     return strdup([NSHomeDirectory() UTF8String]);
 }
 
+const char* GetApplicationSupportDirectory() {
+    NSArray<NSURL *> *urls = [[NSFileManager defaultManager]
+        URLsForDirectory:NSApplicationSupportDirectory
+        inDomains:NSUserDomainMask];
+    NSURL *url = [urls firstObject];
+    return url == nil ? nullptr : strdup([[url path] UTF8String]);
+}
+
+#if TARGET_OS_IPHONE
+
+CocoaWindow::CocoaWindow(void* window)
+    : windowHandle(window), cachedRefreshRate(60) {
+    cachedAttributes = {0, 0, 0, 0};
+    updateWindowAttributesInternal(true);
+    updateRefreshRateInternal(true);
+}
+
+CocoaWindow::~CocoaWindow() {}
+
+void CocoaWindow::updateWindowAttributesInternal(bool forceSync) {
+    auto updateBlock = ^{
+        UIWindow *uiWindow = (__bridge UIWindow *)windowHandle;
+        UIScreen *screen = uiWindow.screen ?: [UIScreen mainScreen];
+        CGRect bounds = uiWindow.bounds;
+        CGFloat scale = screen.nativeScale > 0.0 ? screen.nativeScale : screen.scale;
+
+        std::lock_guard<std::mutex> lock(attributesMutex);
+        cachedAttributes.x = 0;
+        cachedAttributes.y = 0;
+        cachedAttributes.width = static_cast<int>(bounds.size.width * scale);
+        cachedAttributes.height = static_cast<int>(bounds.size.height * scale);
+    };
+
+    if ([NSThread isMainThread]) {
+        updateBlock();
+    } else if (forceSync) {
+        dispatch_sync(dispatch_get_main_queue(), updateBlock);
+    } else {
+        dispatch_async(dispatch_get_main_queue(), updateBlock);
+    }
+}
+
+void CocoaWindow::updateRefreshRateInternal(bool forceSync) {
+    auto updateBlock = ^{
+        UIWindow *uiWindow = (__bridge UIWindow *)windowHandle;
+        UIScreen *screen = uiWindow.screen ?: [UIScreen mainScreen];
+        cachedRefreshRate.store(static_cast<int>(screen.maximumFramesPerSecond));
+    };
+
+    if ([NSThread isMainThread]) {
+        updateBlock();
+    } else if (forceSync) {
+        dispatch_sync(dispatch_get_main_queue(), updateBlock);
+    } else {
+        dispatch_async(dispatch_get_main_queue(), updateBlock);
+    }
+}
+
+void CocoaWindow::getWindowAttributes(CocoaWindowAttributes* attributes) const {
+    const_cast<CocoaWindow*>(this)->updateWindowAttributesInternal(true);
+    std::lock_guard<std::mutex> lock(attributesMutex);
+    *attributes = cachedAttributes;
+}
+
+int CocoaWindow::getRefreshRate() const {
+    const_cast<CocoaWindow*>(this)->updateRefreshRateInternal(true);
+    return cachedRefreshRate.load();
+}
+
+void CocoaWindow::toggleFullscreen() {
+    // iOS applications already own a fullscreen scene.
+}
